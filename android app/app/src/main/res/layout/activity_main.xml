<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space_radial"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="24dp">

    <!-- Ambient Glow behind Controller -->
    <View
        android:id="@+id/haloGlow"
        android:layout_width="@dimen/halo_size"
        android:layout_height="@dimen/halo_size"
        android:alpha="0.6"
        android:background="@drawable/bg_halo_glow_red"
        app:layout_constraintBottom_toBottomOf="@+id/drawCardContainer"
        app:layout_constraintEnd_toEndOf="@+id/drawCardContainer"
        app:layout_constraintStart_toStartOf="@+id/drawCardContainer"
        app:layout_constraintTop_toTopOf="@+id/drawCardContainer" />

    <!-- Perfectly Centered Main Button -->
    <LinearLayout
        android:id="@+id/drawCardContainer"
        android:layout_width="@dimen/draw_button_diameter"
        android:layout_height="@dimen/draw_button_diameter"
        android:background="@drawable/bg_draw_button_unavailable"
        android:clickable="false"
        android:contentDescription="@string/action_draw_unavailable"
        android:elevation="16dp"
        android:enabled="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Connection Status Indicator inside Draw Button -->
        <LinearLayout
            android:id="@+id/connectionStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivConnectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@string/channel_info"
                android:src="@drawable/ic_circle_dot"
                app:tint="@color/status_red" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.15"
                android:text="@string/status_connecting_caps"
                android:textColor="@color/status_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Controller Icon (Chokka / Dice) -->
        <ImageView
            android:id="@+id/ivDrawIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/action_draw_unavailable"
            android:src="@drawable/ic_casino"
            app:tint="@color/status_red" />

        <!-- Main Action Label (DRAW, DRAWING, etc.) -->
        <TextView
            android:id="@+id/tvDrawAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/action_draw_unavailable"
            android:textColor="@color/status_red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Minimalist Status Sub-label -->
        <TextView
            android:id="@+id/tvDrawStatusDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/desc_website_offline"
            android:textColor="@color/status_red"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Discreet Status Feedback (Only pops up if tap is blocked or stage finishes) -->
    <LinearLayout
        android:id="@+id/feedbackContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_toast_pill"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drawCardContainer"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvFeedbackMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="PC Controller offline" />
    </LinearLayout>

    <!-- Footer: Developer Name Only -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvFooterDeveloper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.35"
            android:text="@string/developer_name"
            android:textColor="@color/accent_neon_cyan_bright"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
