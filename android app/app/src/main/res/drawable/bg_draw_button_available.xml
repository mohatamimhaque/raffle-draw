<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D00F0FF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="40%"
                android:gradientRadius="85%p"
                android:startColor="#1E325C"
                android:centerColor="#0E1830"
                android:endColor="#070B16" />
            <stroke
                android:width="2.5dp"
                android:color="#00F0FF" />
        </shape>
    </item>
</ripple>
