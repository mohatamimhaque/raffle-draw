<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RaffleRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_neon_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_neon_purple</item>
        <item name="colorOnPrimary">@color/bg_space</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_neon_pink</item>
        <item name="colorSecondaryVariant">@color/accent_neon_pink</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar and Navigation bar color. -->
        <item name="android:statusBarColor">@color/bg_space</item>
        <item name="android:navigationBarColor">@color/bg_space</item>
        <item name="android:windowBackground">@drawable/bg_space_radial</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.RaffleRemote.Splash" parent="Theme.RaffleRemote">
        <item name="android:windowBackground">@color/bg_space</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
