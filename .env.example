# =================================================================
# OFFICIAL LIVE RAFFLE DRAW SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to raffal_draw/.env and customize values for your event.
# =================================================================

# --- Organization & Event Branding (100% Dynamic) ---
# Top header pill on stage (e.g. University, Company, or Host Organization)
ORGANIZATION_NAME="Dhaka University of Engineering & Technology"

# Main Grand Title on stage, controller, and results PDF
EVENT_NAME="DUET CSE Fest 2026"

# Ceremony / Department / Subtitle line below the event title
SEGMENT_NAME="Department of Computer Science and Engineering"

# Total number of winners / prizes to draw
TOTAL_WINNERS=10

# --- Draw Engine Timing & Animation ---
DRAW_COUNTDOWN_SECONDS=5
SHUFFLE_PASSES=100
WINNER_REVEAL_SECONDS=1
NAME_ROLL_DURATION_MS=1500
BEEP_ENABLED=true
CONFETTI_ENABLED=true

# --- Controller Console Authentication ---
CONTROLLER_USERNAME=admin
CONTROLLER_PASSWORD=change_this_secure_password
SECRET_KEY=generate_a_random_secret_jwt_key_here_for_security

# --- Server Network Binding ---
HOST=0.0.0.0
PORT=8000

# --- Android Mobile Remote Control (Supabase Realtime Transport) ---
# Only required if using the Android Remote Controller mobile app.
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy Project URL and anon public key.
# 3. Realtime Broadcast is used as a zero-latency transport channel.
REMOTE_SESSION_ID=RAFFLE26
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
